// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model InstructionalDesignJob {
  id          Int       @id @default(autoincrement())
  externalId  String    @unique @map("external_id") @db.VarChar(255)
  title       String    @db.VarChar(500)
  company     String?   @db.VarChar(255)
  location    String?   @db.VarChar(255)
  isRemote    Boolean   @default(false) @map("is_remote")
  jobType     String?   @map("job_type") @db.VarChar(100)
  salary      String?   @db.VarChar(255)
  description String?
  applyUrl    String    @map("apply_url")
  source      String?   @db.VarChar(100)
  datePosted  DateTime? @map("date_posted")
  fetchedAt   DateTime  @default(now()) @map("fetched_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([fetchedAt], map: "idx_jobs_fetched_at")
  @@index([isRemote], map: "idx_jobs_is_remote")
  @@index([datePosted], map: "idx_jobs_date_posted")
  @@map("instructional_design_jobs")
}
