# ─── App ──────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/idc_db"

# ─── Public site URL (used for metadata + sitemap) ────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.instructionaldesigncentral.com

# ─── Email (Brevo transactional) ──────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key-here
BREVO_LIST_ID=your-brevo-list-id-here              # numeric ID from Brevo → Contacts → Lists
BREVO_DOI_TEMPLATE_ID=your-doi-template-id-here   # double opt-in confirmation email template (must contain {{ doubleoptin }} link)
BREVO_WELCOME_TEMPLATE_ID=your-template-id-here   # welcome/coupon email — trigger via Brevo automation, not sent directly

# ─── Auth providers (add as you wire them) ────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Job board (Jooble API sync) ───────────────────────────────────────────────
JOOBLE_API_KEY=your-jooble-api-key-here                # register at https://jooble.org/api/about
CRON_SECRET=generate-with-openssl-rand-base64-32       # shared secret checked by /api/jobs/sync
